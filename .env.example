# ==============================================================================
# CivicLens AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your actual .env with real secrets).
# 2. Add your Google AI Studio / Gemma API key below.
# ==============================================================================

# Official Gemma 4 / Google GenAI API Configuration
# Get your API key from https://aistudio.google.com/
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here

# Model Identifier (configurable, defaults to official Gemma/Gemini multimodal endpoint)
GEMMA_MODEL_ID=gemini-2.5-flash

# Maximum Retries for Transient API Failures
GEMMA_MAX_RETRIES=3

# Request Timeout in Seconds
GEMMA_TIMEOUT_SECONDS=45

# Application Environment (development / production)
APP_ENV=development

# Explicit Demo Mode Toggle (false = require live API, true = allow labeled sample fallback)
ENABLE_DEMO_MODE=false

# Default UI Language ('en' for English, 'hi' for Hindi)
DEFAULT_LANGUAGE=en

# Server Configuration
APP_HOST=localhost
APP_PORT=8501
